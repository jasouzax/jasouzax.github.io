# ---- Owner inputs (terraform/terraform.tfvars, never committed) ----
variable "account_id" {
  type        = string
  description = "Cloudflare account id."
}

variable "zone_id" {
  type        = string
  description = "Cloudflare zone id for the public domain (used for Worker routes)."
}

variable "r2_access_key_id" {
  type        = string
  sensitive   = true
  description = "R2 S3 API access key id, used only to upload large media objects."
}

variable "r2_secret_access_key" {
  type        = string
  sensitive   = true
  description = "R2 S3 API secret access key."
}

variable "assets_bucket_name" {
  type    = string
  default = "jazu-assets"
}

variable "kv_namespace_title" {
  type    = string
  default = "jazu-registry"
}

variable "d1_database_name" {
  type    = string
  default = "jazu"
}

variable "production_branch" {
  type    = string
  default = "master"
}

variable "compatibility_date" {
  type    = string
  default = "2026-11-04"
}

variable "pages_origin" {
  type        = string
  default     = null
  description = "Override the Pages origin (for example a preview URL). Defaults to the project's own .pages.dev hostname."
}

variable "workers_dev" {
  type    = bool
  default = true
}

# Worker secrets. Leave null until the personal node is configured.
variable "origin_hmac_secret" {
  type      = string
  default   = null
  sensitive = true
}

variable "access_client_id" {
  type      = string
  default   = null
  sensitive = true
}

variable "access_client_secret" {
  type      = string
  default   = null
  sensitive = true
}

# ---- Generated by `node src/main.ts deploy` (staging var-file) ----
variable "worker_name" {
  type = string
}

variable "pages_project" {
  type = string
}

variable "domain" {
  type = string
}

variable "public_projects" {
  type        = string
  description = "JSON array of public project ids."
  default     = "[]"
}

variable "project_clone_origins" {
  type        = string
  default     = "{}"
  description = "Public project id to HTTPS Git origin map, generated from project repo declarations."
}

variable "personal_origin" {
  type    = string
  default = null
}

variable "worker_bundle" {
  type        = string
  description = "Absolute path of the esbuild-bundled Worker module."
}

variable "large_assets" {
  type = list(object({
    key          = string
    file         = string
    content_type = string
  }))
  default     = []
  description = "Files over the Pages limit that are uploaded to R2."
}
