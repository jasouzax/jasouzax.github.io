<!-- Unnamed styles are inlined before any external theme is requested.
     The compiler extracts geometry from this legacy source; its paint belongs
     only to Default. Other themes inherit geometry without importing Default. -->
<theme>
    <style src="default/default.scss" scope="layout"/>
    <style src="roles.scss"/>
    <style src="slide_skills.scss"/>
    <style><![CDATA[
        #head_tray, #theme_background { display: contents; }
        .needs_js { display: none; }
        :root.js .needs_js { display: revert; }
        .background_entity:nth-of-type(n + 6) { display: none; }
        .site_foot { scroll-snap-align: end; position: relative; z-index: 1; display: flex; flex-wrap: wrap; gap: 1em; justify-content: center; }
        .site_foot_note { margin: 0; }
        a { color: inherit; text-decoration: none; }
        button, summary, label { cursor: pointer; }
        :focus-visible { outline: 2px solid var(--focus, currentColor); outline-offset: 2px; }
        .visually_hidden { position: absolute; width: 1px; height: 1px; padding: 0; overflow: hidden; clip-path: inset(50%); white-space: nowrap; }
        [hidden]:not(.landing_resume):not(.expertise_resume) { display: none !important; }
        @media screen { :is(.landing_resume, .expertise_resume)[hidden] { display: none !important; } }
        .theme_radio, .list_drop_li > input { position: absolute; opacity: 0; }
    ]]></style>
</theme>
