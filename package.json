{
  "name": "jazu",
  "version": "0.12.0",
  "private": true,
  "type": "module",
  "bin": {
    "jazu": "./src/main.ts"
  },
  "scripts": {
    "app:build": "node app/build.mjs",
    "test:app": "node --import tsx tests/app/smoke.ts",
    "build": "node src/main.ts build",
    "pkgbuild": "node --import tsx src/tools/pkgbuild.ts",
    "check": "node src/main.ts check",
    "serve": "node src/main.ts serve",
    "pack": "node src/main.ts pack",
    "icons": "node src/main.ts icons",
    "types": "tsc --noEmit",
    "compare": "node src/tools/compare_css.ts",
    "watch": "node src/main.ts watch",
    "clean": "node src/main.ts clean",
    "test": "node --import tsx --test tests/**/*.test.ts",
    "test:desk:browser": "playwright test --config tests/desk_browser.config.ts",
    "test:work:browser": "npm run build && playwright test --config tests/work_browser.config.ts",
    "test:loading:browser": "playwright test --config tests/loading_browser.config.ts",
    "test:expertise:browser": "playwright test --config tests/expertise_browser.config.ts",
    "test:rireki:browser": "playwright test --config tests/rireki_browser.config.ts",
    "deploy:dry": "node src/main.ts deploy --dry_run",
    "deploy": "node src/main.ts deploy",
    "tf:registry": "node --env-file=.env cloud/infra/registry/setup.ts",
    "tf:staging": "node --env-file=.env cloud/infra/staging/setup.ts",
    "tf:fmt": "terraform -chdir=cloud/infra fmt -recursive",
    "tf:validate": "terraform -chdir=cloud/infra init -backend=false && terraform -chdir=cloud/infra validate",
    "cloud:dev": "wrangler dev --config cloud/infra/wrangler/local.jsonc",
    "db:local": "wrangler d1 migrations apply DB --local --config cloud/infra/wrangler/local.jsonc",
    "push:keys": "node --import tsx src/tools/push_keys.ts",
    "test:pwa:browser": "playwright test --config tests/pwa_browser.config.ts",
    "node": "node --env-file=.env src/main.ts node",
    "server": "npm --prefix server start",
    "extension:install": "node extension/host/install.ts",
    "extension:uninstall": "node extension/host/install.ts --uninstall",
    "test:engine": "node --import tsx --test tests/engine/**/*.test.ts",
    "test:content": "node --import tsx --test tests/content/**/*.test.ts"
  },
  "engines": {
    "node": ">=22.18"
  },
  "dependencies": {
    "@block65/webcrypto-web-push": "^2.0.0",
    "@resvg/resvg-js": "^2.6.2",
    "@simplewebauthn/browser": "14.0.0",
    "@simplewebauthn/server": "14.1.0",
    "@wasmer/sdk": "^0.19.1",
    "@xterm/addon-fit": "^0.10.0",
    "@xterm/xterm": "^5.5.0",
    "ajv": "8.20.0",
    "diff": "^9.0.0",
    "esbuild": "^0.28.2",
    "jose": "^6.2.17",
    "markdown-it": "^15.0.3",
    "mediabunny": "1.66.2",
    "mqtt": "5.16.1",
    "parse5": "^8.1.0",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "^6.5.438",
    "postcss": "^8.5.31",
    "pyodide": "^0.27.8",
    "sass": "^1.106.1",
    "saxes": "^6.0.0",
    "svgpath": "^2.6.0",
    "tsx": "^4.23.15"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/fontkit": "^2.0.9",
    "@types/markdown-it": "^14.2.0",
    "@types/node": "^26.6.5",
    "fontkit": "^2.0.4",
    "linkedom": "^0.18.15",
    "prettier": "^3.9.10",
    "typescript": "^7.0.2",
    "wrangler": "^4.157.0"
  }
}
