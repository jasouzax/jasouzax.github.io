{
  "name": "jazu",
  "version": "0.12.0",
  "private": true,
  "type": "module",
  "bin": {
    "jazu": "./src/main.ts"
  },
  "scripts": {
    "build": "node src/main.ts build",
    "pkgbuild": "node --import tsx src/pkgbuild.ts",
    "check": "node src/main.ts check",
    "serve": "node src/main.ts serve",
    "pack": "node src/main.ts pack",
    "icons": "node src/main.ts icons",
    "types": "tsc --noEmit",
    "compare": "node src/compare_css.ts",
    "watch": "node src/main.ts watch",
    "clean": "node src/main.ts clean",
    "test": "node --import tsx --test tests/*.test.ts",
    "test:desk:browser": "playwright test --config tests/desk_browser.config.ts",
    "test:loading:browser": "playwright test --config tests/loading_browser.config.ts",
    "test:expertise:browser": "playwright test --config tests/expertise_browser.config.ts",
    "test:rireki:browser": "playwright test --config tests/rireki_browser.config.ts",
    "deploy:dry": "node src/main.ts deploy --dry_run",
    "deploy": "node src/main.ts deploy",
    "tf:registry": "node --env-file=.env terraform/registry/setup.ts",
    "tf:staging": "node --env-file=.env terraform/staging/setup.ts",
    "tf:fmt": "terraform -chdir=terraform fmt -recursive",
    "tf:validate": "terraform -chdir=terraform init -backend=false && terraform -chdir=terraform validate",
    "cloud:dev": "wrangler dev --config wrangler.local.jsonc",
    "db:local": "wrangler d1 migrations apply DB --local --config wrangler.local.jsonc",
    "node": "node --env-file=.env src/main.ts node",
    "extension:install": "node extension/host/install.ts",
    "extension:uninstall": "node extension/host/install.ts --uninstall"
  },
  "engines": {
    "node": ">=22.18"
  },
  "dependencies": {
    "@resvg/resvg-js": "^2.6.2",
    "@wasmer/sdk": "^0.19.1",
    "@xterm/addon-fit": "^0.10.0",
    "@xterm/xterm": "^5.5.0",
    "diff": "^9.0.0",
    "esbuild": "^0.28.2",
    "markdown-it": "^15.0.3",
    "parse5": "^8.1.0",
    "postcss": "^8.5.31",
    "pyodide": "^0.27.8",
    "sass": "^1.106.1",
    "saxes": "^6.0.0",
    "svgpath": "^2.6.0",
    "tsx": "^4.23.15"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/fontkit": "^2.0.9",
    "@types/markdown-it": "^14.2.0",
    "@types/node": "^26.6.5",
    "fontkit": "^2.0.4",
    "linkedom": "^0.18.15",
    "prettier": "^3.9.10",
    "typescript": "^7.0.2",
    "wrangler": "^4.157.0"
  }
}
