{
    "manifest_version": 3,
    "name": "JAZU Device Bridge",
    "version": "0.1.0",
    "description": "Connects the JAZU desk on localhost to this machine's shell through a native messaging host.",
    "minimum_chrome_version": "116",
    "key": "",
    "permissions": ["nativeMessaging"],
    "background": { "service_worker": "background.js" },
    "content_scripts": [
        { "matches": ["http://localhost/*"], "js": ["content.js"], "run_at": "document_start", "all_frames": false }
    ]
}
