# Where the Worker lives. https only, except for a local `wrangler dev` (http://127.0.0.1:8787)
JAZU_ORIGIN=https://jasouza.com
# The same value as the Worker secret SERVER_AGENT_SECRET (at least 32 characters). Make one with:  openssl rand -hex 32
SERVER_AGENT_SECRET=
# Everything the page can reach through the file system channel is below this folder
SERVER_ROOT=/
# Optional: fastfetch modules of the public snapshot (colon separated). The default leaves out user, host name, IP and locale
FASTFETCH_STRUCTURE=
