# Copy to `.env` (git-ignored). Never commit real values.
# Used by: `npm run node` (personal node) and `node src/main.ts deploy` (Terraform + wrangler Pages upload).
# Variables already exported in your shell take precedence over this file.

# ---- Personal node ----
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ORIGIN_HMAC_SECRET=replace_with_at_least_32_random_bytes
# Map of PUBLIC project ids to local repository paths, for example {"public_project":"C:/repos/public_project"}
JAZU_REPOSITORIES_JSON={}
# Cloudflare Access service token for the personal node's tunnel hostname (leave unset until configured).
# ACCESS_CLIENT_ID=
# ACCESS_CLIENT_SECRET=
# The three values above are also pushed to the Worker as secrets by `deploy` (via Terraform).

# ---- Deployment (Terraform / D1 migrations / Pages upload) ----
# API token with edit access to Workers Scripts, Workers Routes, Workers KV, D1, R2, Pages; plus Zone read.
CLOUDFLARE_API_TOKEN=
# Wrangler's Pages upload reads the account id from here (same value as TF_VAR_account_id).
CLOUDFLARE_ACCOUNT_ID=

# Terraform variables. Any of these may instead live in terraform/terraform.tfvars.
TF_VAR_account_id=
TF_VAR_zone_id=
# R2 S3 API token (R2 > Manage API tokens), used only to upload large media.
TF_VAR_r2_access_key_id=
TF_VAR_r2_secret_access_key=
# Optional overrides:
# TF_VAR_assets_bucket_name=jazu-assets
# TF_VAR_kv_namespace_title=jazu-registry
# TF_VAR_d1_database_name=jazu
# TF_VAR_pages_origin=https://<preview>.jazu.pages.dev
