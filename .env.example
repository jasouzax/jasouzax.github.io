# Local personal node. Use `node --env-file=.env src/main.ts node`.
ORIGIN_HMAC_SECRET=replace_with_at_least_32_random_bytes
JAZU_REPOSITORIES_JSON={}
# Mapping example: {"public_project":"C:/repos/public_project"}
# Worker secrets belong in `wrangler secret put`, never in content or config.json.
# ACCESS_CLIENT_ID=
# ACCESS_CLIENT_SECRET=
