{
  "compilerOptions": {
    "target": "es2022",
    "module": "esnext",
    "moduleResolution": "bundler",
    "strict": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "skipLibCheck": true,
    "lib": [
      "es2023",
      "dom"
    ],
    "types": [
      "node"
    ],
    "verbatimModuleSyntax": false,
    "jsx": "react",
    "jsxFactory": "jsx",
    "jsxFragmentFactory": "fragment"
  },
  "include": [
    "src",
    "tests"
  ]
}
